# Example env file — copy to /etc/mutman-admin.env and edit.
#   sudo cp deploy/mutman-admin.env.example /etc/mutman-admin.env
#   sudo nano /etc/mutman-admin.env
#   sudo chmod 600 /etc/mutman-admin.env

PORT=3000
SITE_ROOT=/home/azureuser/portfolio
PUBLISH_DIR=/var/www/mutman.tech

# GoatCounter API token (Settings -> API in goatcounter.com).
# Leave empty to hide the Stats tab data.
GOATCOUNTER_URL=https://mutman.goatcounter.com
GOATCOUNTER_TOKEN=
