---
// Base.astro — HTML shell shared by all pages.
// Fonts: IBM Plex Sans 400/600, IBM Plex Mono 400 (self-hosted via Fontsource).
// Arabic pages also import IBM Plex Sans Arabic in their own frontmatter.

import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';

import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ar';
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'en',
  canonical,
  ogImage = '/og.png',
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Absolute OG image URL that keeps the site's base path (GitHub Pages subpath).
const siteBase = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const ogUrl = `${siteBase}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const skip = lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Language auto-detect: respect an explicit choice, otherwise the browser language -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('lang');
          var p = location.pathname;
          var isAr = p === '/ar/' || p.indexOf('/ar/') === 0;
          var browserAr = ((navigator.language || '').toLowerCase().indexOf('ar') === 0);
          var wantAr = stored ? stored === 'ar' : browserAr;
          if (wantAr && !isAr) {
            location.replace('/ar' + (p === '/' ? '/' : p));
          } else if (!wantAr && isAr) {
            location.replace(p.replace(/^\/ar/, '') || '/');
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{skip}</a>
    <slot />

    <!-- GoatCounter — privacy-friendly visit counter -->
    <script
      data-goatcounter="https://mutman.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
      is:inline
    ></script>
  </body>
</html>
